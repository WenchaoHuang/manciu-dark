{
	"name": "Manciu Dark",
	"semanticHighlighting": true,
	"colors": {
		"editor.background": "#1E1E1E",
	},
	"semanticTokenColors": {
		"macro": "#BD59C5",
		"method": "#FF8000",
		"module": "#FFFFFFA0",
		"property": "#BDB76B",
		"enumMember": "#BD59C5",
		"magicFunction": "#BD59C5",
		"operatorOverload": "#FF8000",
		"tomlArrayKey": "#569CD6",
		"tomlTableKey": "#569CD6",

		"variable": "#BDB76B",
		"variable.builtin": "#BD59C5",
		"variable.callable": "#569CD6",
		"variable.classMember": "#BDB76B",
		
		"type": "#FFD700",
		"enum": "#FFD700",
		"namespace": "#FFD700",

		"function": "#FF8000",
		"function.builtin": "#569CD6",
		"function.decorator": {
			"fontStyle": "italic",
			"foreground": "#BD59C5",
		},

		"class": "#FFD700",
		"class.builtin": "#569CD6",
		"class.decorator": {
			"fontStyle": "italic",
			"foreground": "#BD59C5",
		},
		
		"parameter": "#BDB76B",
		"parameter.keywordArgument": "#AA4926",
		"selfParameter":
		{
			"fontStyle": "italic",
			"foreground": "#BDB76B",
		},
		"clsParameter":
		{
			"fontStyle": "italic",
			"foreground": "#BDB76B",
		},
	},
	"tokenColors": [
		{
			"name": "Preprocessor",
			"scope": [
				"keyword.control.directive",
				"entity.other.attribute-name.pragma.preprocessor",
			],
			"settings": {
				"foreground": "#9B9B9B",
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"variable.language",
				"constant.language",
				"entity.name.type.enum",
				"entity.name.tag.localname.xml",
				"entity.name.tag.yaml",

				"storage.type",
				"storage.modifier",
				"storage.modifier.static",
				"storage.modifier.specifier",

				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.cast",
				"keyword.operator.cmake",
				"keyword.operator.typeid",
				"keyword.operator.sizeof",
				"keyword.operator.alignof",
				"keyword.operator.logical.python",
				"keyword.other.delete.constructor.cpp",
				"keyword.other.delete.function.cpp",
				"keyword.other.using.directive",
				"keyword.other.static_assert",
				"keyword.other.item.latex",
				"keyword.other.typename",
				"keyword.other.requires",
				"keyword.other.typedef",
				"keyword.other.concept",
				"keyword.other.default",
				"keyword.other.cmake",
				
				// usd
				"keyword.operator.usd",
				"keyword.import.usd",
				"keyword.other.usd",
				
				// wavefront
				"keyword.function.v.wavefront.obj",
				"keyword.function.f.wavefront.obj",
				"keyword.function.g.wavefront.obj",
				"keyword.function.vn.wavefront.obj",
				"keyword.function.vt.wavefront.obj",
				"keyword.function.usemtl.wavefront.obj",
				"keyword.function.mtllib.wavefront.obj",

				"support.function.cmake",
				"support.function.be.latex",
				"support.function.general.tex",
				"support.function.section.latex",
				"support.function.commandProperty.cmake",
				"support.type.property-name.json.comments",
				"support.type.property-name.json",
				"support.type.property-name.toml",
				"support.type.property.cmake",
				"support.type.python",
				"meta.template.definition",
				"markup.underline.link.markdown",
				"punctuation.definition.markdown",
				"punctuation.definition.table.markdown",
				"punctuation.definition.heading.markdown",
				"punctuation.definition.list.begin.markdown",
			],
			"settings": {
				"foreground": "#569CD6",
			}
		},
		{
			"name": "Function",
			"scope":[
				"entity.name.function.c",
				"entity.name.function.call",
				"entity.name.function.member",
				"entity.name.function.python",
				"entity.name.function.definition",
				"meta.body.function.definition.cpp",
				"meta.function-call.generic.python",
				"constant.other.general.math.tex",
			],
			"settings": {
				"foreground": "#FF8000",
			}
		},
		{
			"name": "Type",
			"scope" :[
				"entity.name.type.cpp",
				"entity.name.type.cuda-cpp",
				"entity.name.type.enum.cpp",
				"entity.name.type.class.cpp",
				"entity.name.type.struct.cpp",
				"entity.name.type.struct.cuda-cpp",
				"entity.name.type.template.cpp",
				"entity.name.type.parameter.cpp",
				"entity.name.scope-resolution.cpp",
				"entity.name.scope-resolution.cuda-cpp",
				"entity.name.scope-resolution.parameter.cpp",
				"entity.name.scope-resolution.parameter.cuda-cpp",
				"entity.name.scope-resolution.namespace.block.cpp",
				"entity.name.scope-resolution.namespace.block.cuda-cpp",
				"entity.name.scope-resolution.function.definition.cpp",
				"entity.name.section.markdown",
				"entity.name.namespace",
				"entity.name.section.latex",
				"storage.type.built-in.cpp",
				"meta.template.definition.cpp",
				//"meta.body.function.definition",		// (args...) <- '...'
			],
			"settings": {
				"foreground": "#FFD700",
			}
		},
		{
			"name": "Comment",
			"scope": [
				"comment",
				"storage.type.class.doxygen",
				"string.quoted.docstring.multi.python",
				"string.quoted.docstring.raw.multi.python",
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#57A64A"
			}
		},
		{
			"name": "Constant Value",
			"scope": [
				"support.type.variable.cmake",
				"entity.name.function.decorator.python",
				"entity.name.function.preprocessor.cpp",
				"entity.name.other.preprocessor.macro.predefined",
				"storage.modifier.specifier.functional.pre-parameters.__host__.cuda-cpp",
				"storage.modifier.specifier.functional.pre-parameters.__device__.cuda-cpp",
				"storage.modifier.__forceinline__.cuda-cpp",
				"storage.modifier.__device__.cuda-cpp",
				"storage.modifier.__global__.cuda-cpp",
				"variable.parameter.function.latex",
				"variable.other.enummember.cpp",
				"fenced_code.block.language",
			],
			"settings": {
				"foreground": "#BD59C5",
			}
		},
		{
			"name": "Python @",
			"scope": [
				"punctuation.definition.decorator.python",
			],
			"settings": {
				"foreground": "#BD59C5",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string.quoted.single",
				"string.quoted.double",
				"string.quoted.binary.single.python",
				"string.quoted.other.lt-gt.include",
				"string.filename.wavefront.obj",
				"string.unquoted.plain.out.yaml",
				"string.unquoted.block.yaml",
				"string.unquoted.cmake",
				"variable.parameter.definition.label.latex",
				"constant.other.reference.label.latex",
				"markup.inline.raw.string.markdown",
			],
			"settings": {
				"foreground": "#D69D85",
			}
		},
		{
			"name": "Constant Number",
			"scope": [
				"constant.numeric.json",
				"constant.numeric.decimal",
				"constant.numeric.math.tex",
				"constant.numeric.dec.python",
				"constant.numeric.float.usda",
				"constant.numeric.float.python",
				"constant.numeric.exponent.decimal",
				"constant.numeric.float.wavefront.obj",
				"constant.numeric.integer.wavefront.obj",
				"constant.numeric.vertex-reference.absolute.wavefront.obj",
				"keyword.other.unit.suffix.floating-point",
				"keyword.other.unit.suffix.integer",
				"keyword.other.unit.exponent.decimal",
				"storage.type.string.python",
			],
			"settings": {
				"foreground": "#B5CEA8",
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.parameter",
				"variable.other.cmake",
				"variable.other.object",
				"variable.other.property",

				"meta.parens",
				"meta.member.access.python",
				"meta.bracket.square.access",

				"storage.type.format.python",
				"constant.character.math.tex",
				"support.class.math.block.environment.latex",
				"support.class.math.block.tex",

				"entity.name.type.template",
				"entity.name.type",	// SeVector<Type, N>::Elements <- 'Elements'
			],
			"settings": {
				"foreground": "#BDB76B",
			}
		},
		{
			"name": "White",
			"scope" :[
				"storage.modifier.pointer",
				"storage.modifier.reference",

				"meta.preprocessor.conditional",

				"keyword.operator",
				"keyword.operator.bitwise",
				"keyword.operator.logical",
				"keyword.operator.arithmetic",
				"keyword.operator.comparison",
				"keyword.operator.assignment",
				"keyword.control.equation.align.latex",
				"keyword.control.equation.newline.latex",
				
				"punctuation.terminator",
				"punctuation.math.operator.latex",
				"punctuation.definition.constant.math.tex",
				"punctuation.vararg-ellipses.template.definition",
				"punctuation.separator.colon",
				"punctuation.separator.dot-access",
				"punctuation.separator.slice.python",
				"punctuation.separator.period.python",
				"punctuation.separator.element.python",
				"punctuation.separator.pointer-access",
				"punctuation.separator.delimiter.comma",
				"punctuation.separator.arguments.python",
				"punctuation.separator.scope-resolution",
				"punctuation.separator.scope-resolution.template.definition",
				"punctuation.section.variable.begin.cmake",
				"punctuation.section.variable.end.cmake",
				"punctuation.section.angle-brackets",
			],
			"settings": {
				"foreground": "#B4B4B4",
			}
		},
		{
			"name": "Deep red",
			"scope": [
				"entity.other.attribute-name.localname.xml",
				"punctuation.definition.string.begin.tex",
				"punctuation.definition.string.end.tex",
			],
			"settings": {
				"foreground": "#AA4926",
			}
		}
	]
}